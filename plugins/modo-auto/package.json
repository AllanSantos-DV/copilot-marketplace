{
  "name": "modo-auto",
  "version": "0.2.99",
  "description": "Modo autonomo por sessao para o Copilot: uma MESA de agentes responde os ask_user e revisa os Stop, com plano vivo, memoria e pesquisa. Nucleo hexagonal (ports & adapters).",
  "type": "module",
  "main": "extension.mjs",
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "test:core": "node test/smoke.mjs",
    "lint:dead": "knip --no-progress",
    "test:live": "node test/run-live.mjs",
    "release:provenance": "node scripts/write-build-provenance.mjs"
  },
  "keywords": [
    "autonomo",
    "mesa",
    "ask_user",
    "stop",
    "agentes",
    "ports-adapters",
    "copilot"
  ],
  "author": "Allan Santos",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AllanSantos-DV/modo-auto.git"
  },
  "devDependencies": {
    "knip": "^6.27.0"
  },
  "files": [
    "src",
    "agents",
    "embed-house",
    "scripts/run-tests.mjs",
    "boot.mjs",
    "boot.neural-link.json",
    "extension.mjs",
    "plugin.json",
    "LICENSE",
    "README.md",
    ".build-provenance.json"
  ]
}